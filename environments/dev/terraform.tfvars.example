# environments/dev/terraform.tfvars.example
# =============================================================================
# TERRAFORM CONFIGURATION EXAMPLE
# Copy file này thành terraform.tfvars và điền giá trị thực tế
# =============================================================================

# ===========================================
# PROJECT IDENTIFICATION
# ===========================================

# Tên project - sử dụng trong naming convention
project = "k8s-pj"

# Environment identifier - dev/staging/prod
environment = "dev"

# Owner/Team identifier - để tracking ownership
owner = "tth"

# ===========================================
# AWS REGION & NETWORKING
# ===========================================

# AWS region để deploy infrastructure
# Note: Phải đồng nhất với region trong backend.tf
region = "ap-southeast-5"

# VPC CIDR block - private IP range cho toàn bộ infrastructure
# /16 cung cấp 65,536 IPs, đủ cho large deployments
vpc_cidr = "10.0.0.0/16"

# Số lượng Availability Zones sử dụng
# 3 AZs đảm bảo high availability, phân bố workload
availability_zones_count = 3

# Enable NAT Gateway cho private subnet internet access
# true: Private instances có thể download packages, pull images
# false: Tiết kiệm cost nhưng private instances isolated
enable_nat_gateway = true

# Enable VPC Endpoints cho AWS services
# true: Traffic đến S3/ECR không qua internet (security + cost)
# false: Sử dụng public internet (có cost cho data transfer)
enable_vpc_endpoints = true

# ===========================================
# KUBERNETES CLUSTER CONFIGURATION
# ===========================================

# Số lượng master nodes - nên là số lẻ cho etcd quorum
# 3 masters: Chịu được 1 node failure
# 5 masters: Chịu được 2 node failures (cho production)
master_count = 3

# Số lượng worker nodes
# Scale theo workload requirements
worker_count = 3

# Instance type cho master nodes
# t3.medium: 2 vCPU, 4GB RAM - minimum cho K8s masters
# m5.large: 2 vCPU, 8GB RAM - recommended cho production
master_instance_type = "t3.medium"

# Instance type cho worker nodes  
# t3.large: 2 vCPU, 8GB RAM - good cho development
# m5.xlarge: 4 vCPU, 16GB RAM - better cho production workloads
worker_instance_type = "t3.large"

# Kubernetes version to install
# Format: major.minor (e.g., "1.28", "1.29")
kubernetes_version = "1.28"

# Containerd version
# Stable version compatible với K8s version
containerd_version = "1.6.24-1"

# ===========================================
# LOAD BALANCER CONFIGURATION
# ===========================================

# SSL Certificate ARN cho HTTPS listener
# null: Chỉ HTTP (development)
# ARN: Enable HTTPS (production)
# Obtain certificate từ AWS Certificate Manager
ssl_certificate_arn = null
# ssl_certificate_arn = "arn:aws:acm:ap-southeast-5:123456789012:certificate/12345678-1234-1234-1234-123456789012"

# Enable ALB deletion protection
# false: Allow deletion (development)
# true: Prevent accidental deletion (production)
enable_deletion_protection = false

# ALB access logs retention in days
# Cost optimization: shorter retention = lower cost
# Compliance: longer retention = audit requirements
access_logs_retention_days = 30

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# Additional resource tags (optional)
# additional_tags = {
#   CostCenter = "engineering"
#   Project    = "kubernetes-platform"
#   Contact    = "devops-team@company.com"
# }

# ===========================================
# DEVELOPMENT OVERRIDES
# ===========================================

# Uncomment để override cho development environment
# master_count = 1          # Single master cho dev
# worker_count = 2          # Ít workers hơn
# enable_nat_gateway = false # Tiết kiệm cost
# enable_vpc_endpoints = false

# ===========================================
# PRODUCTION RECOMMENDATIONS
# ===========================================

# Cho production environment, recommend:
# master_count = 3 hoặc 5
# worker_count = based on workload
# master_instance_type = "m5.large" hoặc lớn hơn
# worker_instance_type = "m5.xlarge" hoặc lớn hơn
# enable_nat_gateway = true
# enable_vpc_endpoints = true
# enable_deletion_protection = true
# ssl_certificate_arn = "your-certificate-arn"
# access_logs_retention_days = 90 hoặc longer